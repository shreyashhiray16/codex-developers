# API server port (default 4000)
API_PORT=4000

# Required in production. Used for /admin GET and DELETE.
ADMIN_TOKEN=change-me-before-production

# Set to production when deploying
# NODE_ENV=production

# Allowed browser origin for CORS in production
# CORS_ORIGIN=https://yourdomain.com

# Team-only lead email notify (Resend)
# Create a key at https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFY_EMAIL=infocodexdevelopers@gmail.com
# Use a verified domain sender in production. For testing you can use:
# MAIL_FROM=Codex Developers <onboarding@resend.dev>
